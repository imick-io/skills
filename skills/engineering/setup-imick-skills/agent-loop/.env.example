# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write), Metadata (Read), and for verify-epic:
# Commit statuses (Read and write), Deployments (Read), Pull requests (Read)
GH_TOKEN=
# Optional: where the loop reports usage limits and failed passes (same webhook as triage alerts).
# SLACK_ALERTS_WEBHOOK_URL=
# Optional: your Slack member ID (profile → ⋮ → Copy member ID), so alerts that need your answer mention you.
# SLACK_USER_ID=
# Optional: fast mode, for projects where speed beats review (personal projects, MVPs): the loop answers
# what waits on you when it's confident enough, asks you in Slack otherwise, approves confident specs
# and merges verified epics. Or put the `fast` label on single epics instead.
# Supersonic goes further, for throwaway MVPs: one interview briefs every epic, reversible calls below
# the threshold are assumed instead of asked, specs are always approved, and you get one Slack digest
# a day of what was assumed. Or the `supersonic` label on single epics.
# AGENTS_MODE=fast              # or supersonic
# AGENTS_THRESHOLD=70           # confidence below which the loop asks (fast) or assumes (supersonic)
# AGENTS_DIGEST_HOURS=24        # supersonic: how often the digest of assumptions is sent
# Optional: triage inside the loop instead of the GitHub Actions workflow (setup asks which). Each pass
# triages new issues with no triage label, needs-info issues the reporter answered, and anything on
# needs-triage. No Actions minutes, but nothing is triaged while the loop is off. Don't run both: strip
# .github/workflows/triage.yml down to its workflow_dispatch trigger.
# AGENTS_TRIAGE=1
# SLACK_FEED_WEBHOOK_URL=       # optional: every triage decision, like the workflow's feed
# Optional tuning (defaults shown):
# AGENTS_IDLE_MINUTES=45
# AGENTS_RETRY_MINUTES=5        # after a failed pass; doubles for each failure in a row, up to the idle minutes
# AGENTS_VERIFY_SKIP=.sandcastle/**,.claude/**,docs/**,*.md,tracker/**   # changes that keep an epic verified
# AGENTS_MAX_PARALLEL=3         # tickets building at once; each is a sandbox (with its services), and all share your usage limit
# AGENTS_SANDBOX=isolated       # sandboxes on a branch copy the repo in and the commits out instead of bind-mounting the worktree:
#                               # dependency installs in seconds instead of minutes on Docker Desktop for Mac (see new-project.md)
# AGENTS_EPIC_GATE=epic         # or ticket: an epic blocked by other epics holds back only its tickets with blockers of their own
# AGENTS_PLANNER_MODEL=claude-opus-5-5
# AGENTS_WORKER_MODEL=claude-sonnet-5
# Optional: credentials for protected previews, named in docs/agents/preview.md, e.g.
# VERCEL_AUTOMATION_BYPASS_SECRET=
